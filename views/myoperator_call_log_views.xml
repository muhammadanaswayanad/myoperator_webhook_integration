<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="myoperator_call_log_view_tree" model="ir.ui.view">
        <field name="name">myoperator.call.log.tree</field>
        <field name="model">myoperator.call.log</field>
        <field name="arch" type="xml">
            <tree string="Call Logs" decoration-danger="call_status == 'missed'">
                <field name="name"/>
                <field name="phone_number"/>
                <field name="call_time"/>
                <field name="call_duration"/>
                <field name="call_status"/>
                <field name="lead_id"/>
                <field name="partner_id"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="myoperator_call_log_view_form" model="ir.ui.view">
        <field name="name">myoperator.call.log.form</field>
        <field name="model">myoperator.call.log</field>
        <field name="arch" type="xml">
            <form string="Call Log">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="phone_number"/>
                            <field name="lead_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="call_time"/>
                            <field name="call_duration"/>
                            <field name="call_status"/>
                        </group>
                    </group>
                    <group>
                        <field name="call_notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="myoperator_call_log_view_search" model="ir.ui.view">
        <field name="name">myoperator.call.log.search</field>
        <field name="model">myoperator.call.log</field>
        <field name="arch" type="xml">
            <search string="Search Call Logs">
                <field name="name"/>
                <field name="phone_number"/>
                <field name="call_status"/>
                <field name="lead_id"/>
                <field name="partner_id"/>
                <filter string="Today" name="today" domain="[('call_time', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="this_week" domain="[('call_time', '&gt;=', (context_today() + relativedelta(weeks=-1, days=1, weekday=0)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month" domain="[('call_time', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="status" context="{'group_by':'call_status'}"/>
                    <filter string="Lead" name="lead" context="{'group_by':'lead_id'}"/>
                    <filter string="Partner" name="partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Date" name="call_date" context="{'group_by':'call_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_myoperator_call_logs" model="ir.actions.act_window">
        <field name="name">Call Logs</field>
        <field name="res_model">myoperator.call.log</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="myoperator_call_log_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No call logs found.
            </p>
            <p>
                Call logs from MyOperator will appear here after calls are processed.
            </p>
        </field>
    </record>

    <!-- DELETE any action_myoperator_settings record if it exists here -->
</odoo>
