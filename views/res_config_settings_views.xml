<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Remove any view that would override the standard settings form -->
    <!-- Only keep a component that adds MyOperator settings to the standard settings page -->
    <record id="res_config_settings_view_form_myoperator" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.myoperator</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="MyOperator" data-key="myoperator_webhook_integration">
                    <h2>MyOperator Integration</h2>
                    <div class="row mt16 o_settings_container" id="myoperator_settings">
                        <!-- ...existing code... -->
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Define a specific action for MyOperator Settings that doesn't override general settings -->
    <record id="action_myoperator_settings" model="ir.actions.act_window">
        <field name="name">MyOperator Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'myoperator_webhook_integration'}</field>
    </record>
</odoo>
