<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.myoperator.webhook</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('app_settings_block')][last()]" position="after">
                <div class="app_settings_block" data-string="MyOperator" id="myoperator_settings_block">
                    <h2>MyOperator Webhook Integration</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="myoperator_webhook_url" string="Webhook URL"/>
                                <div class="text-muted">
                                    Configure this URL in your MyOperator Dashboard for After-Call webhooks
                                </div>
                                <field name="myoperator_webhook_url" readonly="1" class="w-100 mt-2"/>
                                
                                <label for="myoperator_webhook_secret" string="Webhook Secret" class="mt-3"/>
                                <div class="text-muted">
                                    If MyOperator provides a secret token for webhook verification, enter it here
                                </div>
                                <field name="myoperator_webhook_secret" class="w-100 mt-2"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
