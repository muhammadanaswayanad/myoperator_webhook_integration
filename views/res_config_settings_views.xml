<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.myoperator.webhook</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='crm_settings']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="myoperator_webhook_settings">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">MyOperator Webhook Settings</span>
                        <div class="text-muted">
                            Configure webhook settings for MyOperator integration
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <label for="myoperator_webhook_url" string="Webhook URL" class="o_light_label"/>
                                <field name="myoperator_webhook_url" class="oe_inline" readonly="1"/>
                                <div class="text-muted">
                                    Configure this URL in your MyOperator Dashboard for After-Call webhooks
                                </div>
                            </div>
                            <div class="mt16">
                                <label for="myoperator_webhook_secret" string="Webhook Secret" class="o_light_label"/>
                                <field name="myoperator_webhook_secret" class="oe_inline"/>
                                <div class="text-muted">
                                    If MyOperator provides a secret token for webhook verification, enter it here
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
